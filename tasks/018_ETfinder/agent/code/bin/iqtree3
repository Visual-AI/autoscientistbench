#!/usr/bin/env bash
# cap IQ-TREE to ET_THREADS cores; exec the real iqtree3 (envs/iqtree3)
n="${ET_THREADS:-12}"; args=("$@"); out=(); i=0; seen=0
while [ $i -lt ${#args[@]} ]; do
  case "${args[$i]}" in
    -nt|-T) out+=("-nt" "$n"); seen=1; i=$((i+2));;
    *) out+=("${args[$i]}"); i=$((i+1));;
  esac
done
[ $seen -eq 0 ] && out+=("-nt" "$n")
exec "$ET_IQTREE3" "${out[@]}" -seed "${BENCH_SEED:-1}"
