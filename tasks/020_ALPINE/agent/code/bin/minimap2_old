#!/usr/bin/env python3
import os,sys
from pathlib import Path
old=Path(sys.argv[0]).name.endswith('_old')
binary=Path(os.environ['BENCH_RUNTIME_DIR'])/('old_minimap' if old else 'alpine/bin')/'minimap2'
args=sys.argv[1:];budget=int(os.environ.get('BENCH_CPUS','1'))
for i,arg in enumerate(args[:-1]):
 if arg=='-t':args[i+1]=str(min(int(args[i+1]),budget))
os.execv(str(binary),[str(binary),*args])
